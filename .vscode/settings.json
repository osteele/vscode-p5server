// Place your settings in this file to overwrite default and user settings.
{
  "files.exclude": {
    "*.vsix": true,
    "out": true
  },
  "search.exclude": {
    "out": true // set this to false to include "out" folder in search results
  },
  // Turn off tsc task auto detection since we have the necessary tasks as npm scripts
  "typescript.tsc.autoDetect": "off",
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "pasteImage.path": "${currentFileDir}/images",
  "terminal.integrated.automationShell.linux": "/bin/bash",
  "editor.formatOnSave": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "workbench.colorCustomizations": {
    "activityBar.activeBackground": "#ffffff",
    "activityBar.activeBorder": "#8B9DC3",
    "activityBar.background": "#ffffff",
    "activityBar.foreground": "#15202b",
    "activityBar.inactiveForeground": "#15202b99",
    "activityBarBadge.background": "#df9f9f",
    "activityBarBadge.foreground": "#15202b",
    "statusBar.background": "#e7eefd",
    "statusBar.foreground": "#15202b",
    "statusBarItem.hoverBackground": "#b8cdf9",
    "titleBar.activeBackground": "#e7eefd",
    "titleBar.activeForeground": "#15202b",
    "titleBar.inactiveBackground": "#e7eefd99",
    "titleBar.inactiveForeground": "#15202b99",
    "sash.hoverBorder": "#ffffff",
    "statusBarItem.remoteBackground": "#e7eefd",
    "statusBarItem.remoteForeground": "#15202b",
    "commandCenter.border": "#15202b99"
  },
  "peacock.color": "#E7EEFD"
}
